{
  "name": "cssguy4hire",
  "homepage": "https://www.cssguy4hire.com/",
  "version": "5.3.0",
  "private": true,
  "packageManager": "yarn@4.1.0",
  "engines": {
    "node": "^18.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "export": "next export",
    "start": "next start",
    "lint": "yarn eslint && yarn stylelint && yarn prettier",
    "lint:fix": "yarn eslint:fix && yarn stylelint:fix && yarn prettier:fix",
    "eslint": "next lint",
    "eslint:fix": "next lint --fix",
    "stylelint": "stylelint '**/*.scss'",
    "stylelint:fix": "stylelint '**/*.scss' --fix",
    "prettier": "prettier --config .prettierrc.js '{pages,components,stories}/**/*.{js,ts,tsx}' --check",
    "prettier:fix": "prettier --config .prettierrc.js '{pages,components,stories}/**/*.{js,ts,tsx}' --write",
    "postinstall": "husky install",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "next": "14.0.3",
    "react": "^18",
    "react-dom": "^18",
    "react-svg": "^16.1.34",
    "react-transition-group": "^4.4.5"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "1.2.25",
    "@storybook/addon-essentials": "^8.0.2",
    "@storybook/addon-interactions": "^8.0.2",
    "@storybook/addon-links": "^8.0.2",
    "@storybook/addon-onboarding": "^8.0.2",
    "@storybook/blocks": "^8.0.2",
    "@storybook/nextjs": "^8.0.2",
    "@storybook/react": "^8.0.2",
    "@storybook/test": "^8.0.2",
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^20",
    "@types/postcss-flexbugs-fixes": "^5",
    "@types/postcss-pxtorem": "^6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/react-transition-group": "^4",
    "@types/webpack-env": "^1.18.4",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "autoprefixer": "^10.4.16",
    "classnames": "^2.3.2",
    "eslint": "^8",
    "eslint-config-next": "14.0.3",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-perfectionist": "^2.5.0",
    "eslint-plugin-storybook": "^0.8.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "postcss": "^8.4.33",
    "postcss-flexbugs-fixes": "^5.0.2",
